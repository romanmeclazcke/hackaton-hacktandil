---
const features = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    color: "brand",
    title: "Visualización 3D en tiempo real",
    description:
      "Explorá cada rincón de tu futuro apartamento con controles intuitivos. Rotá, zoomá y navegá el espacio como si ya estuvieras adentro.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 8v4l3 3"/><path d="M20 2v6h-6"/></svg>`,
    color: "accent",
    title: "Generación ultrarrápida con IA",
    description:
      "Nuestro modelo de Computer Vision analiza tu plano en segundos. Sin esperas, sin procesos manuales. Subís la imagen y listo.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
    color: "pink",
    title: "Detección automática de ambientes",
    description:
      "Living, dormitorios, baños, cocina — la IA detecta y clasifica cada espacio automáticamente. Sin configuración manual.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l4 2"/></svg>`,
    color: "brand",
    title: "Sin instalación requerida",
    description:
      "100% web. Funciona en cualquier navegador moderno, sin descargas ni plugins. Accedé desde tu computadora o tablet.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    color: "accent",
    title: "Compartí con tu equipo",
    description:
      "Generá un link y compartí la vista 3D con arquitectos, clientes o tu familia. Todos pueden explorar el mismo modelo.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    color: "pink",
    title: "Medidas y dimensiones reales",
    description:
      "Visualizá las medidas exactas de cada ambiente. Planificá muebles y decoración con datos precisos.",
  },
];

const colorMap = {
  brand: {
    bg: "bg-brand-500/10",
    border: "border-brand-500/20",
    text: "text-brand-400",
    glow: "hover:border-brand-500/40 hover:shadow-brand-500/10",
  },
  accent: {
    bg: "bg-accent-500/10",
    border: "border-accent-500/20",
    text: "text-accent-400",
    glow: "hover:border-accent-500/40 hover:shadow-accent-500/10",
  },
  pink: {
    bg: "bg-pink-500/10",
    border: "border-pink-500/20",
    text: "text-pink-400",
    glow: "hover:border-pink-500/40 hover:shadow-pink-500/10",
  },
};
---

<section id="features" class="relative py-32 bg-surface-800/30 overflow-hidden">
  <!-- Subtle separator lines -->
  <div class="absolute inset-0 bg-grid opacity-50"></div>
  <div
    class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-brand-500/20 to-transparent"
  ></div>
  <div
    class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-500/20 to-transparent"
  ></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full glass border border-brand-500/30 text-brand-300 text-xs font-medium mb-6"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="text-brand-400">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
        </svg>
        Características
      </div>
      <h2 class="text-4xl lg:text-5xl font-black text-white leading-tight mb-6">
        Todo lo que necesitás
        <span class="gradient-text"> para visualizar</span>
      </h2>
      <p class="text-lg text-slate-400 leading-relaxed">
        Una plataforma completa para transformar tus planos en experiencias 3D inmersivas.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        features.map(({ icon, color, title, description }, i) => {
          const c = colorMap[color as keyof typeof colorMap];
          return (
            <div
              class={`feature-card reveal p-6 rounded-2xl glass border ${c.border} ${c.glow} hover:shadow-xl transition-all duration-300 group`}
              style={`animation-delay: ${i * 0.1}s`}
            >
              <div
                class={`w-12 h-12 rounded-xl ${c.bg} border ${c.border} flex items-center justify-center mb-4 ${c.text} group-hover:scale-110 transition-transform duration-300`}
                set:html={icon}
              />
              <h3 class="text-base font-bold text-white mb-2">{title}</h3>
              <p class="text-sm text-slate-400 leading-relaxed">{description}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
