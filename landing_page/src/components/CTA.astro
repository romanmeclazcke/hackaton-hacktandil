---
---

<section class="relative py-32 overflow-hidden">
  <!-- Dramatic gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-surface-900 via-brand-950/80 to-surface-900"></div>
  <div class="orb w-[500px] h-[500px] bg-brand-600/20 top-[-100px] left-[50%] translate-x-[-50%]"></div>
  <div class="orb w-[300px] h-[300px] bg-accent-600/15 bottom-0 right-0"></div>

  <!-- Grid overlay -->
  <div class="absolute inset-0 bg-grid opacity-30"></div>

  <!-- Top separator -->
  <div
    class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-brand-500/30 to-transparent"
  ></div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
    <div class="reveal">
      <!-- Badge -->
      <div
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-600/20 border border-brand-500/30 text-brand-300 text-xs font-medium mb-8"
      >
        <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
        Disponible ahora
      </div>

      <!-- Headline -->
      <h2 class="text-5xl lg:text-6xl xl:text-7xl font-black text-white leading-[1.05] mb-8">
        Transformá tus planos
        <br />
        <span class="gradient-text">hoy mismo</span>
      </h2>

      <p class="text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed mb-12">
        No necesitás software especializado, no necesitás ser arquitecto.
        Solo subí tu plano y explorá tu futuro espacio en 3D.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a
          href="http://localhost:5173/login"
          class="group flex items-center gap-3 px-8 py-4 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold text-lg transition-all duration-200 glow-brand hover:scale-[1.02] active:scale-[0.98] shadow-xl shadow-brand-600/30"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          Iniciar sesión
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            class="group-hover:translate-x-1 transition-transform"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="#demo"
          class="flex items-center gap-3 px-8 py-4 rounded-xl glass border border-white/10 hover:border-white/20 text-white font-bold text-lg transition-all duration-200 hover:scale-[1.02]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
          Ver el demo
        </a>
      </div>

      <!-- Trust signals -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-slate-500">
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Open source
        </div>
        <div class="w-1 h-1 rounded-full bg-slate-700"></div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Sin registro
        </div>
        <div class="w-1 h-1 rounded-full bg-slate-700"></div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
          </svg>
          Listo en 2 segundos
        </div>
      </div>
    </div>
  </div>
</section>
