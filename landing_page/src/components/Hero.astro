---
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-surface-900 bg-grid"
>
  <!-- Orbs de fondo -->
  <div
    class="orb w-[600px] h-[600px] bg-brand-600/20 top-[-200px] left-[-200px]"
  ></div>
  <div
    class="orb w-[500px] h-[500px] bg-accent-600/15 bottom-[-100px] right-[-150px]"
  ></div>
  <div
    class="orb w-[300px] h-[300px] bg-pink-600/10 top-[40%] left-[40%]"
  ></div>

  <!-- Radial gradient overlay -->
  <div
    class="absolute inset-0 bg-radial-[at_50%_0%] from-brand-950/60 via-surface-900/80 to-surface-900"
  ></div>

  <div
    class="relative z-10 max-w-7xl mx-auto px-6 pt-28 pb-20 grid lg:grid-cols-2 gap-16 items-center"
  >
    <!-- Left: Text content -->
    <div class="space-y-8">
      <!-- Badge -->
      <div
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full glass border border-brand-500/30 text-brand-300 text-xs font-medium animate-fadeInUp"
      >
        <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
        Hackaton Hacktandil 2026
      </div>

      <!-- Headline -->
      <h1
        class="text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight leading-[1.05] animate-fadeInUp delay-100"
      >
        Tu plano de piso,
        <br />
        en <span class="gradient-text">3D interactivo</span>
      </h1>

      <!-- Sub -->
      <p
        class="text-lg text-slate-400 max-w-lg leading-relaxed animate-fadeInUp delay-200"
      >
        Subí la imagen de tu plano y en segundos explorá cada ambiente de tu
        apartamento en un entorno 3D inmersivo. Sin software especializado, sin
        conocimientos técnicos.
      </p>

      <!-- Stats row -->
      <div
        class="flex items-center gap-8 animate-fadeInUp delay-300"
      >
        <div>
          <div class="text-2xl font-bold text-white">2 seg</div>
          <div class="text-xs text-slate-500 mt-0.5">Generación IA</div>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div>
          <div class="text-2xl font-bold text-white">360°</div>
          <div class="text-xs text-slate-500 mt-0.5">Vista libre</div>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div>
          <div class="text-2xl font-bold text-white">100%</div>
          <div class="text-xs text-slate-500 mt-0.5">En el browser</div>
        </div>
      </div>

      <!-- CTAs -->
      <div class="flex items-center gap-4 animate-fadeInUp delay-400">
        <a
          href="#demo"
          class="group flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold transition-all duration-200 glow-brand hover:scale-[1.02] active:scale-[0.98]"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="group-hover:scale-110 transition-transform"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
          Ver demo en vivo
        </a>
        <a
          href="http://localhost:5173/register"
          class="flex items-center gap-2 px-6 py-3.5 rounded-xl glass border border-white/10 hover:border-white/20 text-slate-300 hover:text-white font-semibold transition-all duration-200 hover:scale-[1.02]"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <line x1="19" y1="8" x2="19" y2="14"/>
            <line x1="22" y1="11" x2="16" y2="11"/>
          </svg>
          Crear cuenta gratis
        </a>
      </div>
    </div>

    <!-- Right: 3D Preview mockup -->
    <div class="relative flex items-center justify-center animate-fadeInUp delay-300">
      <!-- Rotating ring decoration -->
      <div
        class="absolute w-[440px] h-[440px] rounded-full border border-brand-500/10 animate-rotate-slow"
      ></div>
      <div
        class="absolute w-[360px] h-[360px] rounded-full border border-accent-500/10"
        style="animation: rotate-slow 30s linear infinite reverse;"
      ></div>

      <!-- Main card -->
      <div
        class="relative w-full max-w-[420px] rounded-2xl glass border border-white/10 overflow-hidden glow-brand animate-float"
      >
        <!-- Top bar -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-white/[0.02]">
          <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
          <div class="flex-1 mx-3">
            <div class="h-5 rounded-md bg-white/5 flex items-center px-3">
              <span class="text-[10px] text-slate-500">app.viz3d.io/demo</span>
            </div>
          </div>
        </div>

        <!-- Preview content -->
        <div class="aspect-[4/3] relative bg-surface-800 overflow-hidden">
          <!-- 3D room wireframe visual -->
          <svg
            viewBox="0 0 400 300"
            class="w-full h-full"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Floor -->
            <polygon
              points="80,220 200,280 320,220 200,160"
              fill="rgba(59,92,245,0.05)"
              stroke="rgba(91,134,252,0.4)"
              stroke-width="1.5"
            />
            <!-- Left wall -->
            <polygon
              points="80,60 80,220 200,160 200,20"
              fill="rgba(59,92,245,0.08)"
              stroke="rgba(91,134,252,0.35)"
              stroke-width="1.5"
            />
            <!-- Right wall -->
            <polygon
              points="320,60 320,220 200,160 200,20"
              fill="rgba(139,92,246,0.08)"
              stroke="rgba(167,139,250,0.35)"
              stroke-width="1.5"
            />
            <!-- Top (ceiling) -->
            <polygon
              points="80,60 200,20 320,60 200,100"
              fill="rgba(59,92,245,0.04)"
              stroke="rgba(91,134,252,0.2)"
              stroke-width="1"
            />

            <!-- Window on left wall -->
            <rect x="95" y="90" width="60" height="50" rx="2"
              fill="rgba(147,176,255,0.08)"
              stroke="rgba(91,134,252,0.5)"
              stroke-width="1"
            />
            <line x1="125" y1="90" x2="125" y2="140" stroke="rgba(91,134,252,0.3)" stroke-width="0.8"/>
            <line x1="95" y1="115" x2="155" y2="115" stroke="rgba(91,134,252,0.3)" stroke-width="0.8"/>

            <!-- Door on right wall -->
            <rect x="245" y="110" width="45" height="70" rx="2"
              fill="rgba(167,139,250,0.08)"
              stroke="rgba(167,139,250,0.5)"
              stroke-width="1"
            />
            <circle cx="252" cy="147" r="3" fill="rgba(167,139,250,0.6)"/>

            <!-- Furniture: couch -->
            <rect x="110" y="190" width="80" height="25" rx="4"
              fill="rgba(59,92,245,0.2)"
              stroke="rgba(91,134,252,0.4)"
              stroke-width="1"
            />
            <rect x="115" y="180" width="18" height="15" rx="3"
              fill="rgba(59,92,245,0.25)"
              stroke="rgba(91,134,252,0.4)"
              stroke-width="1"
            />
            <rect x="167" y="180" width="18" height="15" rx="3"
              fill="rgba(59,92,245,0.25)"
              stroke="rgba(91,134,252,0.4)"
              stroke-width="1"
            />

            <!-- Furniture: table -->
            <ellipse cx="240" cy="210" rx="35" ry="18"
              fill="rgba(167,139,250,0.1)"
              stroke="rgba(167,139,250,0.4)"
              stroke-width="1"
            />

            <!-- Grid lines on floor -->
            <line x1="140" y1="280" x2="200" y2="160" stroke="rgba(91,134,252,0.08)" stroke-width="0.5"/>
            <line x1="170" y1="285" x2="230" y2="165" stroke="rgba(91,134,252,0.08)" stroke-width="0.5"/>
            <line x1="80" y1="200" x2="320" y2="200" stroke="rgba(91,134,252,0.06)" stroke-width="0.5"/>
            <line x1="90" y1="220" x2="310" y2="220" stroke="rgba(91,134,252,0.06)" stroke-width="0.5"/>

            <!-- Ambient particles -->
            <circle cx="150" cy="70" r="2" fill="rgba(91,134,252,0.6)">
              <animate attributeName="opacity" values="0.6;0.2;0.6" dur="3s" repeatCount="indefinite"/>
            </circle>
            <circle cx="280" cy="50" r="1.5" fill="rgba(167,139,250,0.6)">
              <animate attributeName="opacity" values="0.4;0.8;0.4" dur="4s" repeatCount="indefinite"/>
            </circle>
            <circle cx="200" cy="145" r="3" fill="rgba(244,114,182,0.5)">
              <animate attributeName="opacity" values="0.5;0.1;0.5" dur="2.5s" repeatCount="indefinite"/>
            </circle>
          </svg>

          <!-- Overlay UI elements -->
          <div class="absolute bottom-3 left-3 right-3 flex items-end justify-between">
            <!-- Room label -->
            <div class="px-2.5 py-1 rounded-md glass text-xs text-brand-300 border border-brand-500/20">
              Living Room · 24m²
            </div>
            <!-- Controls hint -->
            <div class="flex gap-1.5">
              <div class="p-1.5 rounded-md glass border border-white/10">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="rgba(148,163,184,0.8)" stroke-width="2">
                  <path d="M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3"/>
                </svg>
              </div>
              <div class="p-1.5 rounded-md glass border border-white/10">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="rgba(148,163,184,0.8)" stroke-width="2">
                  <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35M11 8v6M8 11h6"/>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom info bar -->
        <div class="px-4 py-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></div>
            <span class="text-xs text-slate-400">Modelo generado con IA</span>
          </div>
          <span class="text-xs text-slate-600">3 habitaciones detectadas</span>
        </div>
      </div>

      <!-- Floating badges -->
      <div
        class="absolute -top-4 -right-4 px-3 py-2 rounded-xl glass border border-green-500/20 text-xs text-green-300 font-medium shadow-xl"
        style="animation: float 5s ease-in-out infinite 1s;"
      >
        ✓ Plano procesado
      </div>
      <div
        class="absolute -bottom-4 -left-4 px-3 py-2 rounded-xl glass border border-accent-500/20 text-xs text-accent-300 font-medium shadow-xl"
        style="animation: float 5s ease-in-out infinite 2s;"
      >
        ⚡ 2.1s generación
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-600">
    <span class="text-xs">Scroll para explorar</span>
    <div class="w-5 h-8 rounded-full border border-white/10 flex items-start justify-center p-1">
      <div
        class="w-1 h-2 rounded-full bg-brand-400"
        style="animation: float 2s ease-in-out infinite;"
      ></div>
    </div>
  </div>
</section>
